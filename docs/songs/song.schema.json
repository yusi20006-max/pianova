{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yusi20006-max/pianova/blob/main/docs/songs/song.schema.json",
  "title": "Pianova Song",
  "description": "Offline song and practice exercise document used by the Pianova beginner library.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "composer",
    "category",
    "difficulty",
    "tempo",
    "notes",
    "practiceSections",
    "license"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "composer": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["iranian", "classical", "international", "practice"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "easy", "intermediate"]
    },
    "tempo": { "type": "integer", "minimum": 30, "maximum": 240 },
    "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["midiNote", "startBeat", "duration", "hand"],
        "properties": {
          "midiNote": { "type": "integer", "minimum": 21, "maximum": 108 },
          "startBeat": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "hand": { "type": "string", "enum": ["right", "left", "both"] }
        }
      }
    },
    "practiceSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "startBeat", "endBeat"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "startBeat": { "type": "number", "minimum": 0 },
          "endBeat": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "attribution"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "licenseUrl": { "type": ["string", "null"], "format": "uri" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
